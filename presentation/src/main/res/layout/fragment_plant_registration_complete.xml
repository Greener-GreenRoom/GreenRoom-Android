<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.greener.presentation.ui.home.registration.complete.RegistrationCompleteViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="16dp"
        android:background="@color/registration_background">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_plant_registration_complete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAppearance="@style/head1"
            android:textColor="@color/gray700"
            android:text="@string/plant_registration_complete"
            android:gravity="center"
            android:layout_marginBottom="70dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/tv_plant_registration_complete_mention"
            tools:text="초롱이를 그린룸에\n 추가했어요!"/>

        <!--    todo body5 폰트 수정    -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_plant_registration_complete_mention"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/body5"
            android:textColor="@color/gray700"
            android:text="@string/plant_registration_complete_mention"
            android:background="@drawable/round_all_99"
            android:backgroundTint="@color/white"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/iv_plant_registration_complete"
            />
        
        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/shape_triangle"
            android:backgroundTint="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_plant_registration_complete_mention"/>

        <ImageView
            android:id="@+id/iv_plant_registration_complete"
            android:layout_width="200dp"
            android:layout_height="240dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.7"
            app:layout_constraintWidth_percent="0.55" 
            tools:src="@drawable/asset_plant_main_character"/>
        
        <ImageView
            android:id="@+id/iv_plant_registration_complete_face"
            android:layout_width="70dp"
            android:layout_height="55dp"
            android:layout_marginStart="70dp"
            android:layout_marginTop="55dp"
            app:layout_constraintTop_toTopOf="@id/iv_plant_registration_complete"
            app:layout_constraintStart_toStartOf="@id/iv_plant_registration_complete"
            android:src="@drawable/asset_face_wink"/>

        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:textAppearance="@style/body2"
            android:textColor="@color/white"
            android:text="@string/util_go_home"
            android:background="@drawable/round_all_8"
            android:layout_marginBottom="20dp"
            android:onClickListener="@{() -> viewModel.moveToHome()}"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
