<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:bind="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="actionTodo"
            type="com.greener.domain.model.ActionTodo" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/view_tutorial_top_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/sample_wall"
            android:padding="0dp"
            app:layout_constraintBottom_toTopOf="@id/view_tutorial_bottom_area"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/view_tutorial_bottom_area"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/empty_floor"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="@dimen/green_room_bottom_area_height_percent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/iv_tutorial_window"
            android:layout_width="116dp"
            android:layout_height="177dp"
            android:src="@drawable/asset_window_fleshy_plant_pot"
            app:layout_constraintBottom_toBottomOf="@+id/view_tutorial_top_area"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/view_tutorial_top_area"
            app:layout_constraintVertical_bias="@dimen/green_room_window_vertical_bias" />

        <ImageView
            android:id="@+id/iv_tutorial_shelf"
            android:layout_width="139dp"
            android:layout_height="151dp"
            android:src="@drawable/asset_shelf_flowering_plant_vase"
            app:layout_constraintBottom_toBottomOf="@id/view_tutorial_top_area"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/view_tutorial_top_area"
            app:layout_constraintVertical_bias="@dimen/green_room_shelf_vertical_bias" />

        <ImageView
            android:id="@+id/iv_tutorial_plant_type"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/asset_plant_monstera_deliciosa"
            app:layout_constraintBottom_toBottomOf="@id/gl_tutorial_empty_start"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="@dimen/green_room_plant_height_percent"
            app:layout_constraintHorizontal_bias="@dimen/green_room_plant_horizontal_bias"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="@dimen/green_room_plant_width_percent" />

        <include
            android:id="@+id/include_tutorial_toast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/snackbar_complete_todo"
            bind:seedPoint="@{3}"
            app:layout_constraintBottom_toBottomOf="@+id/iv_tutorial_plant_type"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_tutorial_plant_type"
            android:visibility="invisible"/>


        <ImageView
            android:id="@+id/iv_tutorial_plant_face"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/asset_face_default"
            app:layout_constraintBottom_toBottomOf="@id/iv_tutorial_plant_type"
            app:layout_constraintEnd_toEndOf="@id/iv_tutorial_plant_type"
            app:layout_constraintHeight_percent="@dimen/green_room_plant_face_height_percent"
            app:layout_constraintHorizontal_bias="@dimen/plant_face_horizontal_bias"
            app:layout_constraintStart_toStartOf="@id/iv_tutorial_plant_type"
            app:layout_constraintTop_toTopOf="@id/iv_tutorial_plant_type"
            app:layout_constraintVertical_bias="@dimen/plant_face_vertical_bias"
            app:layout_constraintWidth_percent="@dimen/green_room_plant_face_width_percent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tutorial"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/round_all_8_no_stroke"
            android:text="@string/util_next"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/gl_tutorial_end"
            app:layout_constraintStart_toStartOf="@id/gl_tutorial_begin" />
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/view_tutorial_wallpaper"
            android:background="#66000000"
            android:visibility="gone"/>


        <include
            android:id="@+id/include_tutorial_balloon"
            layout="@layout/view_text_balloon"
            bind:actionTodo="@{actionTodo}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="invisible"
            app:layout_constraintBottom_toTopOf="@+id/iv_tutorial_plant_type"
            app:layout_constraintEnd_toEndOf="@+id/gl_tutorial_center"
            app:layout_constraintStart_toStartOf="@+id/gl_tutorial_center" />



        <LinearLayout
            android:id="@+id/ly_tutorial_text_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/shape_rounded_corner_white_16"
            android:orientation="vertical"
            android:padding="20dp"
            app:layout_constraintBottom_toTopOf="@id/btn_tutorial"
            app:layout_constraintEnd_toEndOf="@id/gl_tutorial_end"
            app:layout_constraintStart_toStartOf="@id/gl_tutorial_begin">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tutorial_character_name"
                android:textAppearance="@style/body5"
                android:textColor="@color/green300" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_tutorial_script"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/tutorial_script1"
                android:textAppearance="@style/body4"
                android:textColor="@color/gray700" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_tutorial_greeny"
            android:layout_width="82.73dp"
            android:layout_height="69.56dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="45dp"
            android:src="@drawable/img_greeny_wink"
            app:layout_constraintBottom_toTopOf="@+id/ly_tutorial_text_box"
            app:layout_constraintStart_toStartOf="@id/gl_tutorial_begin"
            app:layout_constraintTop_toTopOf="@+id/gl_tutorial_empty_start" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/gl_tutorial_empty_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="@dimen/green_room_guide_percent_for_plant_bottom" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/gl_tutorial_begin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="@dimen/grid_system_start" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/gl_tutorial_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_end="@dimen/grid_system_end" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/gl_tutorial_center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>